"""
    newton_coef(x, y)

Coeficientes do polinômio de Newton (diferenças divididas).
"""
function newton_coef(x, y)
    n = length(x)
    a = float.(copy(y))   # cópia: não altera y

    for i in 2:n
        for k in n:-1:i
            a[k] = (a[k] - a[k-1]) / (x[k] - x[k-i+1])
        end
    end
    return a
end

"""
    newton_eval(a, x, X)

Avalia o polinômio de Newton em `X` pelo método de Horner.
"""
function newton_eval(a, x, X)
    n = length(a)
    P = a[n]

    for i in n-1:-1:1
        P = P * (X - x[i]) + a[i]
    end
    return P
end

# Exemplo: pontos de f(x) = x^3 - 2x + 1
let
    x = [0.0, 1.0, 2.0, 4.0]
    y = x .^ 3 .- 2 .* x .+ 1

    a = newton_coef(x, y)
    println("coeficientes: ", a)   # esperado: [1.0, -1.0, 3.0, 1.0]

    # avalia em pontos fora dos nós e compara com o valor exato
    for X in [0.5, 3.0]
        println("P($X) = ", newton_eval(a, x, X), "   exato = ", X^3 - 2X + 1)
    end
end

# Gráfico: f(x) = 1/x interpolada nos nós x0 = 1, x1 = 2, x2 = 4, x3 = 5
using Plots

let
    f(t) = 1 / t
    x = [1.0, 2.0, 4.0, 5.0]
    y = f.(x)

    a = newton_coef(x, y)
    println("coeficientes (1/x): ", a)

    t = range(0.8, 5.2, length=300)
    P = newton_eval.(Ref(a), Ref(x), t)

    plt = plot(t, f.(t), label="f(x) = 1/x", lw=2)
    plot!(plt, t, P, label="P₃(x) (Newton)", lw=2, ls=:dash)
    scatter!(plt, x, y, label="nós", ms=6)
    xlabel!(plt, "x"); ylabel!(plt, "y")
    title!(plt, "Interpolação de Newton para f(x) = 1/x")
    display(plt)
end
