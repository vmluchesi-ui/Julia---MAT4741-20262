#=
Quadratura de Gauss-Legendre — tradução dos Algoritmos 1 e 2 (Matlab) para Julia.

    x, w = gauss_legendre(n)
    I    = gauss_integral(a, b, n, fun)
=#

"""
    gauss_legendre(n) -> (x, w)

Pontos `x` e pesos `w` da quadratura de Gauss-Legendre com `n` pontos em [-1, 1].
"""
function gauss_legendre(n::Integer)
    n < 1 && throw(ArgumentError("n deve ser >= 1"))   # equivale a Info = -1 no pseudocódigo

    x = zeros(n)
    w = zeros(n)

    m = ceil(Int, n/2)

    for i in 1:m
        z = cos(π*(i - 0.25)/(n + 0.5))   # chute inicial
        pp = 0.0

        # Método de Newton
        while true
            p0 = 1.0
            p1 = z
            for k in 2:n                  # recorrência de Bonnet
                p2 = ((2k - 1)*z*p1 - (k - 1)*p0)/k
                p0 = p1
                p1 = p2
            end
            pp = n*(z*p1 - p0)/(z^2 - 1)  # derivada P_n'(z)
            z1 = z
            z = z1 - p1/pp
            if abs(z - z1) < 1e-14
                break
            end
        end

        x[i] = -z
        x[n+1-i] = z

        w[i] = 2/((1 - z^2)*pp^2)
        w[n+1-i] = w[i]
    end

    return x, w
end

"""
    gauss_integral(a, b, n, fun) -> I

Aproxima a integral de `fun` em [a, b] pela quadratura de Gauss com `n` pontos.
"""
function gauss_integral(a, b, n::Integer, fun)
    x, w = gauss_legendre(n)

    xm = (a + b)/2
    xr = (b - a)/2

    I = 0.0
    for i in 1:n
        t = xm + xr*x[i]
        I = I + w[i]*fun(t)
    end

    return xr*I
end

# Exemplo: integral de exp(x) em [0, 1] = e - 1
if abspath(PROGRAM_FILE) == @__FILE__
    I = gauss_integral(0, 1, 5, exp)
    println("Aproximação: ", I)
    println("Exata:       ", exp(1) - 1)
    println("Erro:        ", abs(I - (exp(1) - 1)))
end
