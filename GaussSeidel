#=
Métodos iterativos para Ax = b: Gauss-Seidel e Jacobi.

Decomposição: A = L + D + U
  (L estritamente triangular inferior, D diagonal, U estritamente triangular superior)

Forma matricial  x^(k+1) = T x^(k) + c
  Jacobi:        T_J  = -D⁻¹(L + U),     c_J  = D⁻¹ b
  Gauss-Seidel:  T_GS = -(D + L)⁻¹ U,    c_GS = (D + L)⁻¹ b
  (no Gauss-Seidel isso equivale a resolver (D + L) x^(k+1) = b - U x^(k))

Teorema: a iteração converge para qualquer x^(0)  ⟺  ρ(T) < 1,
onde ρ(T) = max |λᵢ(T)| é o raio espectral.
Estimativa: o erro cai ~ ρ(T)^k, logo k ≈ log(tol) / log(ρ(T)).

Critério de parada: ||x^(k+1) - x^(k)||_∞ / ||x^(k+1)||_∞ < tol
=#

using LinearAlgebra
using Printf

# ----------------------------------------------------------------------
# Utilidades
# ----------------------------------------------------------------------
"""Retorna L, D, U com A = L + D + U."""
function decompor(A)
    A = float.(A)
    return tril(A, -1), Diagonal(diag(A)), triu(A, 1)
end

"""Estritamente diagonal dominante por linhas
(condição suficiente, não necessária, para convergência)."""
function diagonal_dominante(A)
    n = size(A, 1)
    return all(abs(A[i, i]) > sum(abs(A[i, j]) for j in 1:n if j != i) for i in 1:n)
end

"""Matriz de iteração T do método (:jacobi ou :gs)."""
function matriz_iteracao(A, metodo::Symbol)
    L, D, U = decompor(A)
    metodo == :jacobi && return -(D \ (L + U))
    metodo == :gs     && return -(LowerTriangular(D + L) \ U)
    error("metodo deve ser :jacobi ou :gs")
end

raio_espectral(T) = maximum(abs, eigvals(T))

function verificar(A, b)
    A = float.(A); b = float.(b); n = length(b)
    size(A) == (n, n) || error("A deve ser quadrada e compatível com b.")
    any(iszero, diag(A)) && error("Há zero na diagonal; reordene as equações.")
    return A, b, n
end

function imprimir_cabecalho(n)
    @printf("%4s | ", "k")
    for i in 1:n
        @printf("%12s | ", "x$i")
    end
    @printf("%12s\n", "erro rel.")
    println("-"^(8 + 15 * (n + 1)))
end

function imprimir_linha(k, x, erro)
    @printf("%4d | ", k)
    for xi in x
        @printf("%12.8f | ", xi)
    end
    @printf("%12.3e\n", erro)
end

erro_rel(x, x_ant) = norm(x - x_ant, Inf) / max(norm(x, Inf), 1e-30)

# ----------------------------------------------------------------------
# 1) Gauss-Seidel componente a componente (forma clássica)
# ----------------------------------------------------------------------
"""xᵢ^(k+1) = (bᵢ - Σ_{j<i} aᵢⱼ xⱼ^(k+1) - Σ_{j>i} aᵢⱼ xⱼ^(k)) / aᵢᵢ"""
function gauss_seidel(A, b; x0 = nothing, tol = 1e-8, max_iter = 500, verbose = true)
    A, b, n = verificar(A, b)
    x = x0 === nothing ? zeros(n) : float.(copy(x0))
    verbose && imprimir_cabecalho(n)

    for k in 1:max_iter
        x_ant = copy(x)
        for i in 1:n
            s1 = sum(A[i, j] * x[j] for j in 1:i-1; init = 0.0)      # já atualizados
            s2 = sum(A[i, j] * x_ant[j] for j in i+1:n; init = 0.0)  # iteração anterior
            x[i] = (b[i] - s1 - s2) / A[i, i]
        end
        erro = erro_rel(x, x_ant)
        verbose && imprimir_linha(k, x, erro)
        erro < tol && return x, k
    end

    println("Atenção: não convergiu em $max_iter iterações.")
    return x, max_iter
end

# ----------------------------------------------------------------------
# 2) Forma matricial: Jacobi e Gauss-Seidel
# ----------------------------------------------------------------------
"""Jacobi:       D x^(k+1)       = b - (L + U) x^(k)
   Gauss-Seidel: (D + L) x^(k+1) = b - U x^(k)   (substituição progressiva)"""
function iterativo_matricial(A, b; metodo = :gs, x0 = nothing, tol = 1e-8,
                             max_iter = 500, verbose = false)
    A, b, n = verificar(A, b)
    L, D, U = decompor(A)
    DL = LowerTriangular(Matrix(D) + L)
    x = x0 === nothing ? zeros(n) : float.(copy(x0))
    verbose && imprimir_cabecalho(n)

    for k in 1:max_iter
        x_ant = copy(x)
        if metodo == :jacobi
            x = D \ (b - (L + U) * x_ant)
        elseif metodo == :gs
            x = DL \ (b - U * x_ant)
        else
            error("metodo deve ser :jacobi ou :gs")
        end
        erro = erro_rel(x, x_ant)
        verbose && imprimir_linha(k, x, erro)
        erro < tol && return x, k
    end

    println("Atenção: $metodo não convergiu em $max_iter iterações.")
    return x, max_iter
end

# ----------------------------------------------------------------------
# 3) Comparação Jacobi x Gauss-Seidel
# ----------------------------------------------------------------------
function comparar(A, b; tol = 1e-8, max_iter = 500, titulo = "")
    A, b, n = verificar(A, b)
    println("="^70)
    isempty(titulo) || println(titulo)
    println("Diagonal dominante: ", diagonal_dominante(A) ? "sim" : "não")
    @printf("%-14s%12s%14s%12s%14s\n", "Método", "ρ(T)", "k estimado", "k obtido", "resíduo")
    println("-"^66)
    for (nome, met) in [("Jacobi", :jacobi), ("Gauss-Seidel", :gs)]
        ρ = raio_espectral(matriz_iteracao(A, met))
        k_est = 0 < ρ < 1 ? @sprintf("%.1f", log(tol) / log(ρ)) : "diverge"
        x, k = iterativo_matricial(A, b; metodo = met, tol = tol, max_iter = max_iter)
        res = norm(b - A * x, Inf)
        @printf("%-14s%12.6f%14s%12d%14.3e\n", nome, ρ, k_est, k, res)
    end
    println()
end

# ----------------------------------------------------------------------
# Exemplos
# ----------------------------------------------------------------------
# Exemplo 1 (solução exata: x = [1, 2, -1, 1])
A1 = [10 -1  2  0;
      -1 11 -1  3;
       2 -1 10 -1;
       0  3 -1  8]
b1 = [6, 25, -11, 15]

println("Gauss-Seidel (componente a componente) — Exemplo 1\n")
x, it = gauss_seidel(A1, b1)
println("\nSolução após $it iterações: ", round.(x, digits = 10), "\n")

comparar(A1, b1; titulo = "Exemplo 1: matriz diagonal dominante")

# Exemplo 2: tridiagonal (-1, 2, -1) — Poisson 1D.
# Matriz consistentemente ordenada: ρ(T_GS) = ρ(T_J)²,
# ou seja, Gauss-Seidel precisa de ~metade das iterações de Jacobi.
n = 10
A2 = Matrix(SymTridiagonal(fill(2.0, n), fill(-1.0, n - 1)))
b2 = A2 * ones(n)  # solução exata: vetor de uns
comparar(A2, b2; max_iter = 2000, titulo = "Exemplo 2: tridiagonal (-1, 2, -1), n = $n")
ρJ  = raio_espectral(matriz_iteracao(A2, :jacobi))
ρGS = raio_espectral(matriz_iteracao(A2, :gs))
@printf("Verificação: ρ(T_J)² = %.6f  vs  ρ(T_GS) = %.6f\n\n", ρJ^2, ρGS)

# Exemplo 3: Jacobi diverge, Gauss-Seidel converge
# (A simétrica positiva definida ⇒ GS sempre converge; Jacobi não necessariamente)
A3 = [1.0 0.8 0.8;
      0.8 1.0 0.8;
      0.8 0.8 1.0]
b3 = A3 * ones(3)
comparar(A3, b3; max_iter = 200, titulo = "Exemplo 3: SPD, não diagonal dominante")
