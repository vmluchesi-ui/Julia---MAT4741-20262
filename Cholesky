# Decomposição de Cholesky e resolução de Ax = b
# MAT1831 Métodos Numéricos
#
# Implementação fiel aos Algoritmos 1 e 2 da aula.
#
# Convenção dos algoritmos: R é triangular INFERIOR e A = R Rᵀ.
# Para a convenção do Teorema 1.1 (R triangular superior, A = Rᵀ R), use R'.
#
# Uso:  julia cholesky.jl        (roda o exemplo)
#       include("cholesky.jl"); demo()    (no REPL)

using LinearAlgebra

"Algoritmo 1: devolve R triangular inferior com A = R Rᵀ."
function decomposicao_cholesky(A)
    # Verifica se a matriz é simétrica (com tolerância numérica)
    isapprox(A, A') || error("A matriz deve ser simétrica.")

    n = size(A, 1)
    R = zeros(n, n)

    for j in 1:n
        soma = 0.0
        for k in 1:j-1
            soma += R[j, k]^2
        end

        t = A[j, j] - soma
        t <= 0 && error("A matriz não é definida positiva.")
        R[j, j] = sqrt(t)

        for i in j+1:n
            soma = 0.0
            for k in 1:j-1
                soma += R[i, k] * R[j, k]
            end
            R[i, j] = (A[i, j] - soma) / R[j, j]
        end
    end

    return R
end

"Algoritmo 2: resolve Ax = b via Cholesky."
function resolve_cholesky(A, b)
    R = decomposicao_cholesky(A)
    n = length(b)

    y = zeros(n)
    x = zeros(n)

    # Etapa 1: resolver R y = b (substituição direta)
    for i in 1:n
        soma = 0.0
        for k in 1:i-1
            soma += R[i, k] * y[k]
        end
        y[i] = (b[i] - soma) / R[i, i]
    end

    # Etapa 2: resolver Rᵀ x = y (substituição retroativa)
    for i in n:-1:1
        soma = 0.0
        for k in i+1:n
            soma += R[k, i] * x[k]
        end
        x[i] = (y[i] - soma) / R[i, i]
    end

    return x
end

function demo()
    # Exemplos 1.1 a 1.3 da aula
    A = [1.0 2.0 4.0;
         2.0 8.0 10.0;
         4.0 10.0 26.0]
    b = [1.0, -4.0, 10.0]

    R = decomposicao_cholesky(A)
    println("R (triangular inferior, A = R Rᵀ):")
    display(R)
    println("\n\nRᵀ (triangular superior, como no Teorema 1.1):")
    display(Matrix(R'))

    println("\n\ndet(A)        = ", round(det(A), digits = 10))
    println("(prod r_ii)^2 = ", prod(diag(R))^2)
    println("||A - R Rᵀ||  = ", norm(A - R * R'))

    x = resolve_cholesky(A, b)
    println("\nSolução x = ", x)
    println("||Ax - b||    = ", norm(A * x - b))

    # Comparação com a biblioteca
    println("\nConfere com cholesky(A).L? ", R ≈ Matrix(cholesky(A).L))

    # Contraexemplo: simétrica, mas não definida positiva (Δ2 = -3)
    B = [1.0 2.0;
         2.0 1.0]
    try
        decomposicao_cholesky(B)
    catch e
        println("\nContraexemplo [[1,2],[2,1]] -> ", e.msg)
    end
end

if abspath(PROGRAM_FILE) == @__FILE__
    demo()
end
